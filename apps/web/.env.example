# Target of the Vite dev-server proxy for /api (default http://localhost:8080)
VITE_API_PROXY_TARGET=http://localhost:8080

# Optional Google sign-in (docs/deployment.md). Public by design: any VITE_ value can end up in the JavaScript
# bundle, so never put a secret in a VITE_ variable. Leave them empty for no login (the default).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
